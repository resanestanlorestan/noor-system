# Noor System — Environment Variables
# Copy this file to .env and fill in real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/noor_db"

# Local database name (development)
NOOR_DB_NAME=noor_dev

# Data directory for local storage
NOOR_DATA_DIR=./.data

# SMS provider mode: "local" for dev logging, "api" for real gateway
NOOR_SMS_LOCAL=local
