# Copy this file to .env and fill in real values for your local/dev environment.
# Never commit the actual .env file (it is already in .gitignore).

# Required: PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: override the auto-generated one-time admin bootstrap code
# (see .private-app/bootstrap-code if left unset).
# BOOTSTRAP_SETUP_CODE=

# Optional: fixed 64-character hex key for encrypting national IDs and MFA
# secrets at rest. If unset, a random key is generated and stored in
# .private-app/encryption-key. Changing this key after data exists breaks
# decryption of previously stored values.
# APP_ENCRYPTION_KEY=

# --- E-mail delivery (new) ---
# If SMTP_HOST is set, real e-mail delivery is attempted via SMTP (nodemailer).
# Otherwise messages are captured in the local outbox ("صندوق پیام‌ها") and the
# verification/reset links are shown in the UI instead of being e-mailed.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Noor System <no-reply@example.com>"

# --- SMS delivery (new, optional) ---
# Two gateways are supported. If PAYAMAK_PANEL_USERNAME and PAYAMAK_PANEL_API_KEY
# are set, SMS is delivered via the پیامک‌پنل REST API
# (https://rest.payamak-panel.com — used by SMSline and similar panels;
# the APIKey from the panel's ApiSetting page replaces the password, and
# PAYAMAK_PANEL_SENDER is the panel line, e.g. 5000...). PAYAMAK_PANEL_PASSWORD
# is accepted instead of the API key. Otherwise, if KAVENEGAR_API_KEY is set,
# the Kavenegar API is used. With neither, SMS is captured in the local outbox.
# PAYAMAK_PANEL_USERNAME=
# PAYAMAK_PANEL_API_KEY=
# PAYAMAK_PANEL_SENDER=
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=

# --- Sandbox preview embedding (DEMO ONLY — never enable in production!) ---
# When set to 1, the app may be framed by the platform preview panel:
# X-Frame-Options is omitted, CSP frame-ancestors becomes * and the session
# cookie becomes SameSite=None; Secure. Leave unset on real hosts so the
# strict clickjacking protection (frame-ancestors 'none' + DENY) stays on.
# DEMO_EMBED=1

# --- Automated reminder crons (optional) ---
# Secret protecting the automated cron endpoints (overdue-case reminders and
# pre-event reminders). If set, a daily external cron (cPanel → Cron Jobs) calls:
#   curl -fsS "https://YOUR-DOMAIN/api/cron/reminders?key=$CRON_SECRET"
#   curl -fsS "https://YOUR-DOMAIN/api/cron/events?key=$CRON_SECRET"
# Leave unset to disable both endpoints completely (they answer 404).
# CRON_SECRET=
